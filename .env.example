# OWASP Juice Shop Environment Configuration
#
# This file contains example environment variables that can be used to configure
# the Juice Shop application. Copy this file to .env and update the values as needed.

# Ethereum Provider Configuration
# ================================
# WebSocket URL for the Ethereum provider (e.g., Alchemy, Infura)
# Required for NFT minting and Web3 wallet challenges
# Example: wss://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY_HERE
# Example: wss://sepolia.infura.io/ws/v3/YOUR_API_KEY_HERE
ETHEREUM_PROVIDER_URL=

# Other Configuration Options
# ===========================
# These can be set via environment variables or config files

# Server port (default: 3000)
# PORT=3000

# Base path for the application (default: '')
# BASE_PATH=

# Solutions webhook URL for challenge notifications
# SOLUTIONS_WEBHOOK=

# CTF Key for Capture The Flag mode
# CTF_KEY=

# Node environment (development, production, test)
# NODE_ENV=development
