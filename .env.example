# JWT Private Key Configuration
# For production deployments, set this environment variable to your RSA private key
# The key should be in PEM format. You can also use a secret management service.
# If not set, the application will fall back to reading from encryptionkeys/jwt.key
# WARNING: Do not use the default key in production!
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----

# HMAC Key Configuration
# For production deployments, set this environment variable to a strong random key
# Generate a secure key using: openssl rand -base64 32
# WARNING: Do not use the default key in production!
# HMAC_KEY=your_secure_random_hmac_key_here
